{
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0,
        "patch": 0
    },
    "configurePresets": [
        {
            "binaryDir": "${sourceDir}/../build/x64-Debug",
            "description": "Default build using Ninja generator",
            "displayName": "Default Config",
            "environment": {
            },
            "generator": "Ninja",
            "hidden": true,
            "name": "default"
        },
        {
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "description": "Use this preset for Debug mode in Visual Studio.",
            "displayName": "Debug",
            "hidden": true,
            "inherits": "default",
            "name": "debug_preset"
        },
        {
            "binaryDir": "${sourceDir}/../build/x64-Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            },
            "description": "Use this preset for Release mode in Visual Studio.",
            "displayName": "Release",
            "hidden": true,
            "inherits": "default",
            "name": "release_preset"
        },
        {
            "architecture": {
                "strategy": "external",
                "value": "x86"
            },
            "binaryDir": "${sourceDir}/../build/x32-Debug",
            "description": "Use this preset for Debug mode in Visual Studio.",
            "displayName": "Debug (x86)",
            "hidden": false,
            "inherits": "debug_preset",
            "name": "debug_x86_preset",
            "toolset": {
                "strategy": "external",
                "value": "host=x64"
            }
        },
        {
            "architecture": {
                "strategy": "external",
                "value": "x86"
            },
            "binaryDir": "${sourceDir}/../build/x32-Release",
            "description": "Use this preset for Release mode in Visual Studio.",
            "displayName": "Release (x86)",
            "hidden": false,
            "inherits": "release_preset",
            "name": "release_x86_preset",
            "toolset": {
                "strategy": "external",
                "value": "host=x64"
            }
        }
    ],
    "version": 3
}
